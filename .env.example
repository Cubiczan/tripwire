# Copy to .env (gitignored). Never commit real keys.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Latest docs list https://api.sandbox.airwallex.com; older docs used https://api-demo.airwallex.com.
# Confirm against the sandbox account you are given.
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# Only needed if the API key covers several accounts.
AIRWALLEX_LOGIN_AS=
